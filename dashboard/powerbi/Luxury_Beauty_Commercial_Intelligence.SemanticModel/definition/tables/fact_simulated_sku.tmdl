table fact_simulated_sku
	lineageTag: 125314dd-c539-500c-bcc0-e0f2285a928a

	measure 'SKU gross contribution' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_sku[gross_profit]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
