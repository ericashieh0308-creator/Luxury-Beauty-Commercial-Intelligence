table commercial_kpi
	lineageTag: e06b8ba9-ddd6-5d10-9ce6-98b6c2d7e29b

	measure 'Exclusive share' = IF(HASONEVALUE(commercial_kpi[vintage]) && HASONEVALUE(commercial_kpi[market]) && HASONEVALUE(commercial_kpi[snapshot]), CALCULATE(DIVIDE(SUM(commercial_kpi[flagged]), SUM(commercial_kpi[known])), commercial_kpi[dimension] = "overall", commercial_kpi[metric] = "exclusive"))
		formatString: 0.0%
		lineageTag: 952f395f-4f5a-5a97-bea9-229e03df0da8

	measure 'Online share' = IF(HASONEVALUE(commercial_kpi[vintage]) && HASONEVALUE(commercial_kpi[market]) && HASONEVALUE(commercial_kpi[snapshot]), CALCULATE(DIVIDE(SUM(commercial_kpi[flagged]), SUM(commercial_kpi[known])), commercial_kpi[dimension] = "overall", commercial_kpi[metric] = "online"))
		formatString: 0.0%
		lineageTag: 1add7269-4381-5262-b93e-055b2333c019

	measure 'Bestseller share' = IF(HASONEVALUE(commercial_kpi[vintage]) && HASONEVALUE(commercial_kpi[market]) && HASONEVALUE(commercial_kpi[snapshot]), CALCULATE(DIVIDE(SUM(commercial_kpi[flagged]), SUM(commercial_kpi[known])), commercial_kpi[dimension] = "overall", commercial_kpi[metric] = "bestseller"))
		formatString: 0.0%
		lineageTag: dfb8d8a9-83eb-5c9b-84f5-e3cf89b70d23

	measure 'New Arrival share' = IF(HASONEVALUE(commercial_kpi[vintage]) && HASONEVALUE(commercial_kpi[market]) && HASONEVALUE(commercial_kpi[snapshot]), CALCULATE(DIVIDE(SUM(commercial_kpi[flagged]), SUM(commercial_kpi[known])), commercial_kpi[dimension] = "overall", commercial_kpi[metric] = "new_arrival"))
		formatString: 0.0%
		lineageTag: 0629a79c-6726-5128-8135-be1e14c82196


