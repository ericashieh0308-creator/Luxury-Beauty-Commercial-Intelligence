		summarizeBy: none
		sourceColumn: valid_discount_observations

	column mean_discount_depth
		dataType: double
		formatString: 0.0%
		lineageTag: e1dc8821-c06b-5e79-864a-149b29cb22f7
		summarizeBy: none
		sourceColumn: mean_discount_depth

	column cohort_key
		dataType: string
		lineageTag: 9b3ec911-1fd2-5291-a9a8-5047883b44d3
		summarizeBy: none
		sourceColumn: cohort_key

	partition discount_summary = m
		mode: import
		source =
				PortfolioTables[discount_summary]

	annotation PBI_ResultType = Table
