table product_position
	lineageTag: f3ef84ef-6965-5887-9ded-536cb5e02913

	measure 'Native median list price' = IF(HASONEVALUE(product_position[vintage]) && HASONEVALUE(product_position[market]) && HASONEVALUE(product_position[snapshot]), MEDIAN(product_position[price]))
		formatString: #,0.00
		lineageTag: 854c5e82-d6b0-59fa-b7b2-9d3e4d4dc3fe

	measure 'Eligible priced products' = COUNTROWS(product_position)
		formatString: 0
		lineageTag: 9cbbaeb3-3ddd-5d86-a872-117b0b341623


