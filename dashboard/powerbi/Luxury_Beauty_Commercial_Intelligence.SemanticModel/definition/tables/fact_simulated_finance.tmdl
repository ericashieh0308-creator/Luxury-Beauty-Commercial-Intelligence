table fact_simulated_finance
	lineageTag: 7dc1d592-316d-461c-9060-61a7163833a1

	measure 'Simulated net revenue' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[net_revenue]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: bc809a60-4274-58ab-b634-96ad2bfd4fe8

	measure 'Simulated COGS' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[cogs]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: 6303f13c-4110-5f25-aac5-3a23323d20f4

	measure 'Simulated gross profit' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[gross_profit]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: b2035db8-e244-5ac6-a58c-b42c77bbe5fe

	measure 'Simulated operating profit' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[operating_profit]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: 34128893-0238-5d00-ad1b-8aceb29f3fc5

	measure 'Simulated contribution' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[contribution]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: 290d1e93-0f51-5394-9d2f-0ca2d1cd7284

	measure 'Weighted gross margin' = DIVIDE([Simulated gross profit], [Simulated net revenue])
		formatString: 0.0%
		lineageTag: ff89f81e-381c-5950-942e-9af5d38866e0

	measure 'Weighted operating margin' = DIVIDE([Simulated operating profit], [Simulated net revenue])
		formatString: 0.0%
		lineageTag: 6744ff04-7aca-5ac7-8717-af2a6c9c5247


	measure 'Simulated gross sales' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[gross_sales]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: f22bf753-5c49-5ba9-a714-50f00fb5f951

	measure 'Simulated operating expenses' = VAR ScenarioName = IF(ISFILTERED(dim_scenario[scenario]), SELECTEDVALUE(dim_scenario[scenario]), "Base") RETURN IF(NOT ISBLANK(ScenarioName), CALCULATE(SUM(fact_simulated_finance[variable_expenses]) + SUM(fact_simulated_finance[fixed]), KEEPFILTERS(dim_scenario[scenario] = ScenarioName)))
		formatString: "USD "#,0;("USD "#,0)
		lineageTag: 44f0649a-35f6-5da4-a6aa-50aa957a635f

