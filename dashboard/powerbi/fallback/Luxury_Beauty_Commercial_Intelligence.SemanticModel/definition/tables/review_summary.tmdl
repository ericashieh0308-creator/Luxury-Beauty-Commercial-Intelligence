		lineageTag: db3fef3d-a55a-526c-953f-cc9a5998612d

	measure 'Reviews missing source text' = SUM(review_summary[missing_text])
		formatString: 0
		lineageTag: 4c17d4bd-5936-5252-91f5-f5cef83a2327


	column product
